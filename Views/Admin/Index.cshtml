@{
    ViewData["Title"] = "Administration";
}
<section><p class="eyebrow">Master data</p><h1>Administration</h1></section>
<div class="grid">
    <section class="card">
        <h2>Add dining hall</h2>
        <form method="post" action="/Admin/Hall">
            @Html.AntiForgeryToken()
            <label>Name<input name="name" required /></label>
            <label>Capacity<input name="capacity" type="number" min="1" required /></label>
            <button class="primary" type="submit">Add hall</button>
        </form>
    </section>
    <section class="card">
        <h2>Update today's menu</h2>
        <form method="post" action="/Admin/Menu">
            @Html.AntiForgeryToken()
            <label>Dining hall<select name="diningHallId">@foreach (var hall in ViewBag.Halls) { <option value="@hall.Id">@hall.Name</option> }</select></label>
            <label>Meal<select name="mealType"><option>Breakfast</option><option selected>Lunch</option><option>Dinner</option></select></label>
            <label>Dish<input name="dishName" required /></label>
            <label>Prepared quantity<input name="preparedQuantity" type="number" min="1" value="400" /></label>
            <label>Estimated cost<input name="estimatedCost" type="number" step="0.01" min="0" value="8000" /></label>
            <button class="primary" type="submit">Save menu</button>
        </form>
    </section>
</div>
<section class="card">
    <h2>Dining halls</h2>
    <div class="table-wrap"><table><thead><tr><th>Name</th><th>Capacity</th><th>Status</th></tr></thead><tbody>
    @foreach (var hall in ViewBag.Halls) { <tr><td>@hall.Name</td><td>@hall.Capacity</td><td>@(hall.IsActive ? "Active" : "Inactive")</td></tr> }
    </tbody></table></div>
</section>
